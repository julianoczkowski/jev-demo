# Jev credentials: set ONE of these. TypeSafe's own signups are paused (Sept 2026),
# the other three serve the same model. Auto-detected in this order; force with JEV_PROVIDER=.

# OpenRouter  https://openrouter.ai/settings/keys   (model typesafe/jev-latest)
OPENROUTER_API_KEY=

# Vercel AI Gateway  https://vercel.com/ai-gateway   (model typesafe-ai/jev)
# AI_GATEWAY_API_KEY=

# Cloudflare Workers AI  https://dash.cloudflare.com/profile/api-tokens  (needs Workers AI permission)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# TypeSafe direct  https://console.typesafe.ai/keys
# TYPESAFE_API_KEY=

# Optional
# JEV_PROVIDER=openrouter|vercel|cloudflare|typesafe
# JEV_MOCK=1                # offline rule-based stand-in, no key needed
# WHISPER_URL=http://127.0.0.1:8178
